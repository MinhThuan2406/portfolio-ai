# ==============================================================================
# Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# SECURITY GUIDELINES:
# 1. Never commit `.env` or any file containing real secrets/tokens to Git.
# 2. In Astro, variables prefixed with `PUBLIC_` are exposed to client-side
#    browser bundles. NEVER prefix private API keys or credentials with `PUBLIC_`.
# 3. For production deployments (e.g., Vercel / GitHub Actions), configure
#    environment variables via the platform's encrypted Secrets Manager.
# ==============================================================================

# Optional public canonical site URL (safe for client-side/SEO metadata)
PUBLIC_SITE_URL=https://thuannm04.vercel.app
