---
import { featuredDossier } from "../data/portfolio";
import IconArrow from "./IconArrow.astro";
---

<section class="dossier-section" id="work" aria-labelledby="dossier-heading">
  <div class="frame-container">
    <!-- 24-Column Blueprint Section Header (No Eyebrow Kicker above H2!) -->
    <div class="grid-24 section-header-grid" data-section-header>
      <div class="section-header-left">
        <h2 id="dossier-heading" class="section-title" data-rolling-title>
          Featured project: In-cockpit vehicle copilot.
        </h2>
      </div>
      <div class="section-header-right">
        <p class="section-lead" data-section-lead>
          Engineered for the <strong>FPT Automotive Hackathon 2026</strong> (Top 13 Finalist nationwide out of 300+ teams).
          An embedded voice assistant on Android Automotive OS designed to query 84 dense vehicle service manuals
          with exact spatial and part-number citations.
        </p>
      </div>
    </div>

    <!-- Framed Blueprint Dossier Card -->
    <article class="dossier-frame" data-dossier-frame>
      <div class="dossier-topbar mono">
        <div class="dossier-meta-left">
          <span class="dossier-index">01</span>
          <span>{featuredDossier.code}</span>
        </div>
        <div class="dossier-meta-right">
          <span>{featuredDossier.badge}</span>
          <span class="meta-sep">/</span>
          <span class="dossier-highlight-badge">{featuredDossier.recognition}</span>
        </div>
      </div>

      <div class="grid-24 dossier-body-grid">
        <!-- Left 12 Columns: Narrative + 3-Step Engineering Breakdown -->
        <div class="dossier-narrative-col">
          <h3 class="dossier-project-title" data-dossier-copy>
            {featuredDossier.title}
            <span class="dossier-subtitle">{featuredDossier.subtitle}</span>
          </h3>

          <p class="dossier-summary" data-dossier-copy>
            {featuredDossier.summary}
          </p>

          <div class="dossier-steps">
            {
              featuredDossier.breakdown.map((step) => (
                <div class="dossier-step-row" data-step-row>
                  <span class="step-num-pixel">{step.num}</span>
                  <div class="step-body">
                    <strong class="step-label">{step.label}:</strong>{" "}
                    <span>{step.text}</span>
                  </div>
                </div>
              ))
            }
          </div>

          <div class="dossier-cta-row" data-dossier-copy>
            <a class="blueprint-inline-link mono" href="#project-notes">
              <span>VIEW DETAILED ARCHITECTURE NOTES [A–C]</span>
              <span class="btn-arrow-wrap" aria-hidden="true">
                <IconArrow width={11} height={11} />
              </span>
            </a>
          </div>
        </div>

        <!-- Right 12 Columns: Isometric 2.5D System Architecture & Stat Cubes (.on-blue) -->
        <figure
          class="dossier-diagram-col on-blue"
          aria-label="Isometric architecture diagram and benchmark metrics for Digital Cockpit Copilot"
        >
          <figcaption class="diagram-topbar mono">
            <span>FIG 01.1 // IN-COCKPIT RETRIEVAL ARCHITECTURE</span>
            <span>ANDROID AUTOMOTIVE OS</span>
          </figcaption>

          <div class="diagram-canvas">
            <!-- Live Nualt-style Bezier Hex Stream & Data Packet Canvas -->
            <canvas class="pipeline-stream-canvas" data-dossier-stream aria-hidden="true"></canvas>

            <svg
              class="dossier-iso-svg"
              viewBox="0 0 560 320"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <!-- Isometric Reference Grid Lines -->
              <g stroke="currentColor" stroke-opacity="0.16" stroke-width="1" stroke-dasharray="3 3">
                <line x1="20" y1="70" x2="540" y2="70" />
                <line x1="20" y1="160" x2="540" y2="160" />
                <line x1="20" y1="250" x2="540" y2="250" />
                <line x1="150" y1="20" x2="150" y2="300" />
                <line x1="360" y1="20" x2="360" y2="300" />
              </g>

              <!-- Node 1: 84 Service Manuals + RapidOCR Spatial Parser (Stacked Isometric Slabs) -->
              <g transform="translate(26, 42)" data-iso-assembly>
                <!-- Bottom Slab -->
                <g data-iso-layer="0">
                  <polygon
                    points="75,44 140,76 75,108 10,76"
                    fill="currentColor"
                    fill-opacity="0.12"
                    stroke="currentColor"
                    stroke-width="1.3"
                  />
                  <polygon
                    points="10,76 75,108 75,124 10,92"
                    fill="currentColor"
                    fill-opacity="0.08"
                    stroke="currentColor"
                    stroke-width="1.3"
                  />
                  <polygon
                    points="75,108 140,76 140,92 75,124"
                    fill="currentColor"
                    fill-opacity="0.22"
                    stroke="currentColor"
                    stroke-width="1.3"
                  />
                </g>

                <!-- Middle Slab -->
                <g data-iso-layer="1">
                  <polygon
                    points="75,24 140,56 75,88 10,56"
                    fill="currentColor"
                    fill-opacity="0.16"
                    stroke="currentColor"
                    stroke-width="1.3"
                  />
                  <polygon
                    points="10,56 75,88 75,104 10,72"
                    fill="currentColor"
                    fill-opacity="0.1"
                    stroke="currentColor"
                    stroke-width="1.3"
                  />
                  <polygon
                    points="75,88 140,56 140,72 75,104"
                    fill="currentColor"
                    fill-opacity="0.26"
                    stroke="currentColor"
                    stroke-width="1.3"
                  />
                </g>

                <!-- Top Slab -->
                <g data-iso-layer="2">
                  <polygon
                    points="75,4 140,36 75,68 10,36"
                    fill="currentColor"
                    fill-opacity="0.22"
                    stroke="currentColor"
                    stroke-width="1.5"
                  />
                  <text
                    x="75"
                    y="40"
                    text-anchor="middle"
                    fill="currentColor"
                    font-family="var(--font-pixel)"
                    font-size="14">84 PDF</text
                  >
                </g>

                <text
                  x="75"
                  y="148"
                  text-anchor="middle"
                  fill="currentColor"
                  font-family="var(--font-mono)"
                  font-weight="600"
                  font-size="10">MANUAL INGESTION</text
                >
                <text
                  x="75"
                  y="164"
                  text-anchor="middle"
                  fill="currentColor"
                  font-family="var(--font-mono)"
                  font-size="9"
                  opacity="0.8">RapidOCR Table &amp; Pinout</text
                >
              </g>

              <!-- Connector 1 -> 2 -->
              <g stroke="currentColor" stroke-width="1.5">
                <line x1="172" y1="112" x2="218" y2="112" stroke-dasharray="4 4" />
                <polygon points="218,108 226,112 218,116" fill="currentColor" />
              </g>

              <!-- Node 2: Central Hybrid Search + Cross-Encoder RRF Cube -->
              <g transform="translate(226, 30)" data-iso-assembly>
                <g data-iso-layer="1">
                  <polygon
                    points="10,48 76,84 76,156 10,120"
                    fill="currentColor"
                    fill-opacity="0.1"
                    stroke="currentColor"
                    stroke-width="1.5"
                  />
                  <polygon
                    points="76,84 142,48 142,120 76,156"
                    fill="currentColor"
                    fill-opacity="0.28"
                    stroke="currentColor"
                    stroke-width="1.5"
                  />
                  <text
                    x="43"
                    y="108"
                    text-anchor="middle"
                    fill="currentColor"
                    font-family="var(--font-mono)"
                    font-size="9">BM25</text
                  >
                  <text
                    x="109"
                    y="108"
                    text-anchor="middle"
                    fill="currentColor"
                    font-family="var(--font-mono)"
                    font-size="9">CHROMA</text
                  >
                </g>

                <g data-iso-layer="2">
                  <polygon
                    points="76,12 142,48 76,84 10,48"
                    fill="currentColor"
                    fill-opacity="0.2"
                    stroke="currentColor"
                    stroke-width="1.5"
                  />
                  <polygon
                    points="76,28 116,50 76,72 36,50"
                    stroke="currentColor"
                    stroke-width="1"
                    stroke-dasharray="3 3"
                  />
                  <text
                    x="76"
                    y="53"
                    text-anchor="middle"
                    fill="currentColor"
                    font-family="var(--font-mono)"
                    font-weight="700"
                    font-size="10">HYBRID RRF</text
                  >
                </g>

                <text
                  x="76"
                  y="178"
                  text-anchor="middle"
                  fill="currentColor"
                  font-family="var(--font-mono)"
                  font-weight="600"
                  font-size="10">CROSS-ENCODER RERANK</text
                >
                <text
                  x="76"
                  y="194"
                  text-anchor="middle"
                  fill="currentColor"
                  font-family="var(--font-mono)"
                  font-size="9"
                  opacity="0.8">76% → 100% Accuracy</text
                >
              </g>

              <!-- Connector 2 -> 3 -->
              <g stroke="currentColor" stroke-width="1.5">
                <line x1="374" y1="112" x2="416" y2="112" stroke-dasharray="4 4" />
                <polygon points="416,108 424,112 416,116" fill="currentColor" />
              </g>

              <!-- Node 3: FastAPI Async Router (<5ms) & Cited Voice Output -->
              <g transform="translate(426, 44)" data-iso-assembly>
                <g data-iso-layer="2">
                  <rect
                    x="0"
                    y="12"
                    width="114"
                    height="106"
                    fill="currentColor"
                    fill-opacity="0.14"
                    stroke="currentColor"
                    stroke-width="1.5"
                  />
                  <line x1="0" y1="36" x2="114" y2="36" stroke="currentColor" stroke-width="1.2" />
                  <circle cx="12" cy="24" r="3" fill="currentColor" />
                  <circle cx="22" cy="24" r="3" stroke="currentColor" stroke-width="1.2" />
                  <text
                    x="57"
                    y="72"
                    text-anchor="middle"
                    fill="currentColor"
                    font-family="var(--font-pixel)"
                    font-size="18">&lt;5ms</text
                  >
                  <text
                    x="57"
                    y="92"
                    text-anchor="middle"
                    fill="currentColor"
                    font-family="var(--font-mono)"
                    font-size="9"
                    opacity="0.85">ASYNC ROUTER</text
                  >
                </g>
                <text
                  x="57"
                  y="144"
                  text-anchor="middle"
                  fill="currentColor"
                  font-family="var(--font-mono)"
                  font-weight="600"
                  font-size="10">CITED COCKPIT AUDIO</text
                >
                <text
                  x="57"
                  y="160"
                  text-anchor="middle"
                  fill="currentColor"
                  font-family="var(--font-mono)"
                  font-size="9"
                  opacity="0.8">Exact Page &amp; Fuse ID</text
                >
              </g>

              <!-- Bottom Metric Strip inside SVG -->
              <g transform="translate(20, 246)">
                <rect
                  x="0"
                  y="0"
                  width="164"
                  height="54"
                  fill="currentColor"
                  fill-opacity="0.1"
                  stroke="currentColor"
                  stroke-width="1.2"
                />
                <text
                  x="14"
                  y="24"
                  fill="currentColor"
                  font-family="var(--font-pixel)"
                  font-size="16">100%</text
                >
                <text
                  x="14"
                  y="42"
                  fill="currentColor"
                  font-family="var(--font-mono)"
                  font-size="9"
                  opacity="0.85">DIAGNOSTIC RECALL</text
                >

                <rect
                  x="178"
                  y="0"
                  width="164"
                  height="54"
                  fill="currentColor"
                  fill-opacity="0.1"
                  stroke="currentColor"
                  stroke-width="1.2"
                />
                <text
                  x="192"
                  y="24"
                  fill="currentColor"
                  font-family="var(--font-pixel)"
                  font-size="16">&lt;5ms</text
                >
                <text
                  x="192"
                  y="42"
                  fill="currentColor"
                  font-family="var(--font-mono)"
                  font-size="9"
                  opacity="0.85">INTENT CLASSIFICATION</text
                >

                <rect
                  x="356"
                  y="0"
                  width="164"
                  height="54"
                  fill="currentColor"
                  fill-opacity="0.1"
                  stroke="currentColor"
                  stroke-width="1.2"
                />
                <text
                  x="370"
                  y="24"
                  fill="currentColor"
                  font-family="var(--font-pixel)"
                  font-size="16">84 DOCS</text
                >
                <text
                  x="370"
                  y="42"
                  fill="currentColor"
                  font-family="var(--font-mono)"
                  font-size="9"
                  opacity="0.85">SCHEMATICS INDEXED</text
                >
              </g>
            </svg>
          </div>
        </figure>
      </div>

      <!-- 4-Cell Exposed Blueprint Evidence Bar -->
      <div class="dossier-evidence-grid">
        {
          featuredDossier.evidence.map((item) => (
            <div class="evidence-cell" data-evidence-cell>
              <span class="evidence-label mono">{item.label}</span>
              <strong class="evidence-value">
                {item.isLive && <i class="status-beacon" aria-hidden="true" />}
                {item.value}
              </strong>
            </div>
          ))
        }
      </div>
    </article>

    <!-- System Notes Accordion (Nualt FAQ / Technical Spec Pattern with Dashed Dividers) -->
    <div class="notes-block" id="project-notes" data-faq-section>
      <div class="grid-24 notes-grid">
        <div class="notes-intro-col" data-faq-head>
          <h3 class="notes-heading">
            Inside the system: How we solved technical manual retrieval.
          </h3>
          <p class="notes-subcopy">
            Standard vector databases assume every document is clean prose. Automotive service
            manuals are pinout schematics, torque matrices, and multi-column fuse tables.
          </p>
        </div>

        <div class="notes-accordion-col" data-faq-group>
          {
            featuredDossier.notes.map((note) => (
              <details class="blueprint-details" open={note.defaultOpen} data-faq-item>
                <summary class="blueprint-summary">
                  <span class="summary-code mono">[{note.code}]</span>
                  <span class="summary-title">{note.title}</span>
                  <span class="summary-plus mono" aria-hidden="true">+</span>
                </summary>
                <div class="details-body">
                  <p>{note.content}</p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
