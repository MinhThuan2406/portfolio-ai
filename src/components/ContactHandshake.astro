---
import IconArrow from "./IconArrow.astro";
---

<footer
  class="contact-footer-section on-blue"
  id="contact"
  data-nav-blue
  aria-labelledby="contact-heading"
>
  <div class="contact-stage">
    <div
      class="footer-checkerboard-gutter"
      data-tetris-border="gutter"
      aria-hidden="true"
    >
    </div>
    <div class="frame-container grid-24 contact-grid">
      <div class="contact-copy-col">
        <h2 id="contact-heading" class="contact-title" data-rolling-title>
          Let&rsquo;s connect.
        </h2>

        <p class="contact-lead" data-contact-appear>
          I&rsquo;m completing my degree in late 2026 and looking for
          opportunities as a
          <strong>Junior</strong> or <strong
            >Fresher AI Engineer / Backend Engineer</strong
          >. I&rsquo;m eager to learn, receive code reviews, and contribute to
          production services.
        </p>

        <div class="contact-cta-group" data-contact-appear>
          <a
            class="btn-inverted-solid"
            href="mailto:thuannm0426@gmail.com"
            data-pixel-btn
          >
            <span class="btn-label">thuannm0426@gmail.com</span>
            <span class="btn-arrow-wrap" aria-hidden="true">
              <IconArrow width={12} height={12} />
            </span>
          </a>

          <button
            type="button"
            id="copy-email-btn"
            class="btn-inverted-outline mono"
            data-email="thuannm0426@gmail.com"
            data-pixel-btn
            aria-label="Copy email address to clipboard"
          >
            <span class="btn-label" id="copy-email-label">COPY EMAIL</span>
          </button>
        </div>

        <div class="contact-direct-meta mono" data-contact-appear>
          <div>
            <span class="direct-lbl">PHONE:</span>
            <a href="tel:+84819786704">+84 819-786-704</a>
          </div>
          <div>
            <span class="direct-lbl">LOCATION:</span>
            <span>HO CHI MINH CITY, VIETNAM (UTC + 7)</span>
          </div>
        </div>
      </div>

      <div class="contact-terminal-col">
        <div class="code-window-wrapper" data-code-window-wrap>
          <div class="code-window-shadow" data-code-shadow aria-hidden="true">
          </div>

          <div class="code-window" data-code-window>
            <div class="os-window-bar mono">
              <div class="os-window-controls" aria-hidden="true">
                <span class="os-dot"></span>
                <span class="os-dot"></span>
                <span class="os-dot"></span>
              </div>
              <span class="code-filename"
                >handshake.ts — AI &amp; Backend Engineering</span
              >
              <button
                type="button"
                id="replay-typing-btn"
                class="code-replay-btn mono"
                aria-label="Replay live code typing animation"
              >
                [REPLAY ↻]
              </button>
            </div>

            <div class="code-typing-stage" id="cta-code-typing">
              <pre
                class="code-pre mono"
                id="cta-code-pre"
                aria-label="TypeScript engineering profile specification"><code><span class="c-kw">interface</span> <span class="c-type">Profile</span> &#123;
  <span class="c-prop">candidate</span>: <span class="c-str">"Nguyen Minh Thuan"</span>;
  <span class="c-prop">degree</span>: <span class="c-str">"B.S. Computer Science &amp; Engineering (VNU-HCM)"</span>;
  <span class="c-prop">interests</span>: [<span class="c-str">"RAG Pipelines"</span>, <span class="c-str">"Vector Databases"</span>, <span class="c-str">"LLM Inference &amp; APIs"</span>];
&#125;

<span class="c-kw">type</span> <span class="c-type">TargetRole</span> = <span class="c-str">`$&#123;"Fresher" | "Junior"&#125; $&#123;"AI" | "Backend"&#125; Engineer`</span>;

<span class="c-kw">export async function</span> <span class="c-fn">initiateHandshake</span>(
  <span class="c-prop">role</span>: <span class="c-type">TargetRole</span>
) &#123;
  <span class="c-kw">return await</span> <span class="c-fn">dispatchContact</span>(&#123;
    <span class="c-prop">email</span>: <span class="c-str">"thuannm0426@gmail.com"</span>,
    <span class="c-prop">location</span>: <span class="c-str">"HCMC | Remote"</span>,
    <span class="c-prop">status</span>: <span class="c-str">"Open to opportunities (Late 2026)"</span>,
  &#125;);
&#125;</code></pre>
            </div>
          </div>
        </div>

        <div class="social-bento-frame">
          <div
            class="cta-tetris-strip"
            data-tetris-border="cta"
            aria-hidden="true"
          >
          </div>
          <div class="social-bento-grid mono" data-cta-icons>
            <a
              class="social-bento-cell"
              data-bento-cell
              data-pixel-btn
              href="https://github.com/MinhThuan2406"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="bento-channel">GITHUB // REPOS</span>
              <strong class="bento-handle">
                <span>github.com/MinhThuan2406</span>
                <span class="btn-arrow-wrap" aria-hidden="true">
                  <IconArrow width={12} height={12} />
                </span>
              </strong>
            </a>

            <a
              class="social-bento-cell"
              data-bento-cell
              data-pixel-btn
              href="https://linkedin.com/in/nguyenthuan2406"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="bento-channel">LINKEDIN // NETWORK</span>
              <strong class="bento-handle">
                <span>in/nguyenthuan2406</span>
                <span class="btn-arrow-wrap" aria-hidden="true">
                  <IconArrow width={12} height={12} />
                </span>
              </strong>
            </a>

            <button
              type="button"
              class="social-bento-cell"
              data-bento-cell
              data-pixel-btn
              data-open-cv
              aria-label="View Resume PDF"
            >
              <span class="bento-channel">CURRICULUM VITAE</span>
              <strong class="bento-handle">
                <span>CV (PDF)</span>
                <span class="btn-arrow-wrap" aria-hidden="true">
                  <IconArrow width={12} height={12} />
                </span>
              </strong>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
