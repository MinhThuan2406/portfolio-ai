---
import IconArrow from "./IconArrow.astro";
---

<header class="site-header" id="site-header" data-nav-inverted="false">
  <div class="header-grid">
    <a class="header-cell header-brand" href="#top" aria-label="Nguyen Minh Thuan, home">
      <span class="brand-name">THUAN</span><span class="brand-brace mono" aria-hidden="true">.DEV</span>
    </a>

    <nav class="header-nav" aria-label="Primary section navigation">
      <a class="header-cell nav-link" href="#work" data-section="work" data-pixel-btn>
        <span class="nav-index mono">01</span>
        <span>Projects</span>
      </a>
      <a class="header-cell nav-link" href="#practice" data-section="practice" data-pixel-btn>
        <span class="nav-index mono">02</span>
        <span>Systems &amp; Stack</span>
      </a>
      <a class="header-cell nav-link" href="#background" data-section="background" data-pixel-btn>
        <span class="nav-index mono">03</span>
        <span>Experience</span>
      </a>
      <a class="header-cell nav-link" href="#contact" data-section="contact" data-pixel-btn>
        <span class="nav-index mono">04</span>
        <span>About</span>
      </a>
    </nav>

    <div class="header-actions">
      <a
        class="header-cell header-github mono"
        href="https://github.com/MinhThuan2406"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub profile @MinhThuan2406"
        data-pixel-btn
      >
        <svg class="github-icon" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
        <span>GitHub</span>
      </a>

      <button
        type="button"
        class="header-cell header-cv mono"
        data-open-cv
        data-pixel-btn
        aria-label="View Resume PDF"
      >
        <span>RESUME (PDF)</span>
        <IconArrow width={10} height={10} />
      </button>

      <button
        type="button"
        id="theme-toggle"
        class="header-cell theme-toggle-btn"
        aria-label="Toggle color theme"
        title="Toggle Blueprint Polarity (Light / Dark)"
      >
        <svg class="sun-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5"></circle>
          <line x1="12" y1="2" x2="12" y2="4"></line>
          <line x1="12" y1="20" x2="12" y2="22"></line>
          <line x1="4.93" y1="4.93" x2="6.34" y2="6.34"></line>
          <line x1="17.66" y1="17.66" x2="19.07" y2="19.07"></line>
          <line x1="2" y1="12" x2="4" y2="12"></line>
          <line x1="20" y1="12" x2="22" y2="12"></line>
          <line x1="4.93" y1="19.07" x2="6.34" y2="17.66"></line>
          <line x1="17.66" y1="6.34" x2="19.07" y2="4.93"></line>
        </svg>
        <svg class="moon-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <a class="header-cell header-cta" href="#contact" data-pixel-btn>
        <span>Get in touch</span>
        <IconArrow width={11} height={11} />
      </a>

      <button
        type="button"
        id="mobile-menu-toggle"
        class="header-cell mobile-menu-btn mono"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        aria-label="Toggle navigation menu"
      >
        <span class="menu-label">MENU</span>
      </button>
    </div>
  </div>

  <div id="mobile-nav-drawer" class="mobile-drawer" hidden>
    <nav class="mobile-drawer-nav" aria-label="Mobile section navigation">
      <a class="mobile-drawer-link" href="#work">
        <span class="mono">01</span>
        <span>Featured Dossier</span>
      </a>
      <a class="mobile-drawer-link" href="#pipelines">
        <span class="mono">02</span>
        <span>Production Pipelines</span>
      </a>
      <a class="mobile-drawer-link" href="#practice">
        <span class="mono">03</span>
        <span>Stack &amp; Architecture</span>
      </a>
      <a class="mobile-drawer-link" href="#background">
        <span class="mono">04</span>
        <span>System Trajectory</span>
      </a>
      <button type="button" class="mobile-drawer-link" data-open-cv>
        <span class="mono">CV</span>
        <span>Resume / PDF Dossier</span>
      </button>
      <a class="mobile-drawer-link mobile-drawer-cta" href="#contact">
        <span class="mono">05</span>
        <span>Initiate Handshake</span>
      </a>
    </nav>
  </div>
</header>
