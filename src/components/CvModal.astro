---
import IconArrow from "./IconArrow.astro";
---

<div id="cv-modal" class="cv-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Resume PDF Viewer">
  <div class="cv-modal-backdrop" id="cv-modal-backdrop"></div>

  <div class="cv-modal-window">
    <div class="cv-modal-header mono">
      <div class="cv-header-left">
        <div class="os-window-controls" aria-hidden="true">
          <span class="os-dot"></span>
          <span class="os-dot"></span>
          <span class="os-dot"></span>
        </div>
        <span class="cv-title">RESUME // NGUYEN_MINH_THUAN.PDF</span>
      </div>

      <div class="cv-header-actions">
        <button
          type="button"
          class="cv-btn mono"
          id="cv-download-btn"
          aria-label="Download CV as PDF file"
        >
          <span class="btn-text">DOWNLOAD ↓</span>
        </button>
        <button
          type="button"
          class="cv-btn mono"
          id="cv-newtab-btn"
          aria-label="Open CV PDF in new tab"
        >
          <span class="btn-text">NEW TAB</span>
          <span class="btn-arrow-wrap" aria-hidden="true">
            <IconArrow width={10} height={10} />
          </span>
        </button>
        <button
          type="button"
          id="cv-modal-close"
          class="cv-close-btn mono"
          aria-label="Close CV Viewer"
        >
          <span>CLOSE [ESC] ✕</span>
        </button>
      </div>
    </div>

    <div class="cv-modal-body" id="cv-modal-body">
      <div class="cv-pages-container">
        <div class="cv-page-card">
          <div class="cv-page-meta mono">PAGE 01 / 02</div>
          <div class="cv-page-canvas">
            <img
              src="/cv-page-1.webp"
              alt="Nguyen Minh Thuan - Resume Page 1"
              class="cv-page-img"
              width="1240"
              height="1754"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>

        <div class="cv-page-card">
          <div class="cv-page-meta mono">PAGE 02 / 02</div>
          <div class="cv-page-canvas">
            <img
              src="/cv-page-2.webp"
              alt="Nguyen Minh Thuan - Resume Page 2"
              class="cv-page-img"
              width="1240"
              height="1754"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .cv-modal {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.24s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.24s ease;
  }

  .cv-modal.is-open {
    opacity: 1;
    visibility: visible;
  }

  .cv-modal-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(14, 16, 19, 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .cv-modal-window {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 920px;
    height: 90vh;
    display: flex;
    flex-direction: column;
    background-color: var(--bg);
    border: 1px solid var(--border-solid);
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.35);
    overflow: hidden;
    transform: scale(0.97) translateY(8px);
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cv-modal.is-open .cv-modal-window {
    transform: scale(1) translateY(0);
  }

  .cv-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1rem;
    background-color: var(--bg-alt);
    border-bottom: 1px solid var(--border-solid);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    user-select: none;
    flex-shrink: 0;
    gap: 1rem;
  }

  .cv-header-left {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
  }

  .cv-title {
    font-weight: 600;
    color: var(--fg);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cv-header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .cv-header-actions > :not(.cv-btn):not(.cv-close-btn),
  .cv-header-actions [class*="savior"],
  .cv-header-actions [id*="savior"],
  .cv-header-actions [class*="idm"],
  .cv-header-actions [id*="idm"],
  .cv-header-actions img:not(.cv-page-img) {
    display: none !important;
  }

  .cv-btn,
  .cv-close-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.32rem 0.65rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-decoration: none;
    border: 1px solid var(--border-solid);
    background-color: var(--bg);
    color: var(--fg);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .cv-btn:hover,
  .cv-btn:focus-visible {
    background-color: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }

  .cv-close-btn {
    background-color: transparent;
    border-color: transparent;
    color: var(--fg-muted);
  }

  .cv-close-btn:hover,
  .cv-close-btn:focus-visible {
    color: var(--fg);
    background-color: rgba(0, 0, 0, 0.06);
    border-color: var(--border-solid);
  }

  .cv-modal-body {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 1.5rem 1rem 2.5rem;
    background-color: rgba(5, 62, 135, 0.04);
    -webkit-overflow-scrolling: touch;
  }

  .cv-pages-container {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .cv-page-card {
    display: flex;
    flex-direction: column;
    background-color: var(--bg);
    border: 1px solid var(--border-solid);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .cv-page-meta {
    padding: 0.45rem 0.85rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--fg-muted);
    background-color: var(--bg-alt);
    border-bottom: 1px solid var(--border-solid);
  }

  .cv-page-canvas {
    width: 100%;
    line-height: 0;
    background-color: #ffffff;
  }

  .cv-page-img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 760px) {
    .cv-modal {
      padding: 0.5rem;
    }

    .cv-modal-window {
      height: 95vh;
    }

    .cv-modal-header {
      padding: 0.5rem 0.65rem;
    }

    .cv-title {
      display: none;
    }

    .cv-modal-body {
      padding: 0.75rem 0.5rem 1.5rem;
    }

    .cv-pages-container {
      gap: 1rem;
    }
  }
</style>
