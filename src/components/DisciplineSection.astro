---
import { physicalDiscipline } from "../data/portfolio";
---

<section class="discipline-section" id="discipline" aria-labelledby="discipline-heading">
  <div class="frame-container">
    <!-- 24-Column Section Header (No Eyebrow Kicker above H2!) -->
    <div class="grid-24 section-header-grid" data-section-header>
      <div class="section-header-left">
        <h2 id="discipline-heading" class="section-title" data-rolling-title>
          Off the server: Progressive overload &amp; physical cadence.
        </h2>
      </div>
      <div class="section-header-right">
        <p class="section-lead" data-section-lead>
          Engineering and strength training follow the exact same law: show up on schedule, track
          every metric, apply progressive overload, and never compromise form under heavy load.
        </p>
      </div>
    </div>

    <!-- Blueprint Spec Table for Physical Cadence -->
    <div class="discipline-frame grid-24" data-ledger-frame>
      <div class="discipline-stats-col">
        <div class="discipline-stat-cell" data-trace-row>
          <span class="discipline-stat-label mono" data-row-head>WORKING BARBELL LOAD</span>
          <span class="discipline-stat-pixel" data-row-body>{physicalDiscipline.workingSets}</span>
          <span class="discipline-stat-sub mono" data-row-body>COMPOUND WORKING SETS</span>
        </div>

        <div class="discipline-stat-cell" data-trace-row>
          <span class="discipline-stat-label mono" data-row-head>TRAINING TENURE</span>
          <span class="discipline-stat-pixel" data-row-body>{physicalDiscipline.consistency}</span>
          <span class="discipline-stat-sub mono" data-row-body>UNBROKEN WEEKLY CADENCE</span>
        </div>
      </div>

      <div class="discipline-schedule-col">
        <div class="schedule-topbar mono">
          <span>WEEKLY PROTOCOL // {physicalDiscipline.splitBadge}</span>
          <span>RECOVERY &amp; DISCIPLINE</span>
        </div>

        <div class="schedule-grid" role="list" aria-label="Weekly strength training schedule">
          {
            physicalDiscipline.schedule.map((slot) => (
              <div class="schedule-cell" role="listitem" data-trace-row>
                <div class="schedule-day-row mono" data-row-head>
                  <span class="schedule-day">{slot.day}</span>
                  <span class="schedule-focus">{slot.focus}</span>
                </div>
                <p class="schedule-detail" data-row-body>{slot.detail}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
