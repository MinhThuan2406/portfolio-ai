---
import IconArrow from "./IconArrow.astro";
---

<section class="hero-section" aria-labelledby="intro-title">
  <!-- Tier 1: Warm Drafting Ivory Statement & Thesis -->
  <div class="hero-top">
    <div class="frame-container grid-24 hero-top-grid">
      <div class="hero-headline-col">
        <h1 id="intro-title" class="hero-title" data-rolling-title>
          High-throughput backends &amp; search pipelines <em>grounded in real data.</em>
        </h1>
      </div>

      <div class="hero-lead-col">
        <p class="hero-copy" data-hero-appear>
          I&rsquo;m <strong>Nguyen Minh Thuan</strong>, a final-year Computer Science &amp; Engineering student at
          <strong>International University (VNU-HCM)</strong>, graduating in late 2026.
          I focus on the pragmatic, messy side of software engineering: building reliable
          RAG pipelines over unstructured technical documents, designing low-latency event
          telemetry, and shipping resilient backend services that fail gracefully instead 
          of silently guessing.
        </p>

        <div class="hero-actions" data-hero-appear>
          <a class="btn-blueprint-primary" href="#work" data-pixel-btn>
            <span class="btn-label">View Featured Work</span>
            <span class="btn-arrow-wrap" aria-hidden="true">
              <IconArrow width={12} height={12} />
            </span>
          </a>
          <button
            type="button"
            class="btn-blueprint-outline"
            data-open-cv
            data-pixel-btn
            aria-label="View Resume PDF"
          >
            <span class="btn-label">View Resume (PDF)</span>
            <span class="btn-arrow-wrap" aria-hidden="true">
              <IconArrow width={12} height={12} />
            </span>
          </button>
          <a class="btn-blueprint-ghost mono" href="mailto:thuannm0426@gmail.com">
            <span>thuannm0426@gmail.com</span>
            <IconArrow width={11} height={11} />
          </a>
        </div>

        <div class="hero-location-strip mono" data-hero-appear>
          <span class="status-beacon" aria-hidden="true"></span>
          <span>LOCATION: HO CHI MINH CITY, VIETNAM (OPEN TO ON-SITE &amp; REMOTE)</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Tier 2: Full-Bleed Cobalt Blueprint Board (.on-blue) -->
  <div class="hero-blueprint on-blue" data-nav-blue data-hero-panel>
    <div class="shaded-grid-layer" data-shaded-grid aria-hidden="true"></div>
    <span class="hero-boundary-h" data-hero-boundary="horizontal" aria-hidden="true"></span>
    <div class="frame-container grid-24 hero-blueprint-grid">
      <!-- Left: Isometric Pixel & Vector Transformation Matrix -->
      <div class="hero-matrix-col" data-hero-boundary="vertical">
        <div class="matrix-header mono">
          <span>FIG 00.1 // HYBRID RETRIEVAL &amp; TELEMETRY PIPELINE</span>
          <span class="matrix-status">
            <i class="status-beacon" aria-hidden="true"></i>
            ONLINE · HCMC / REMOTE
          </span>
        </div>

        <div
          class="matrix-stage"
          role="img"
          aria-label="Blueprint diagram showing unstructured vehicle manuals and xAPI streams passing through Hybrid RAG and async routers into verified low-latency outputs"
        >
          <!-- Live Nualt-style Bezier Hex Stream & Data Packet Canvas -->
          <canvas class="pipeline-stream-canvas" data-hero-stream aria-hidden="true"></canvas>

          <svg
            class="hero-isometric-svg"
            viewBox="0 0 680 230"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <!-- Subtle Blueprint Coordinate Grid -->
            <g stroke="currentColor" stroke-opacity="0.14" stroke-width="1" stroke-dasharray="3 3">
              <line x1="0" y1="45" x2="680" y2="45" />
              <line x1="0" y1="115" x2="680" y2="115" />
              <line x1="0" y1="185" x2="680" y2="185" />
              <line x1="140" y1="0" x2="140" y2="230" />
              <line x1="340" y1="0" x2="340" y2="230" />
              <line x1="540" y1="0" x2="540" y2="230" />
            </g>

            <!-- Stage 1: Raw Unstructured Inputs + Live Falling Tetris Block Matrix -->
            <g transform="translate(24, 34)" data-stage-node="input">
              <rect
                x="0"
                y="0"
                width="156"
                height="162"
                stroke="currentColor"
                stroke-opacity="0.55"
                stroke-width="1.2"
                fill="currentColor"
                fill-opacity="0.04"
              />
              <!-- Live Tetris / Telemetry Block Matrix (8 cols x 5 rows of 14px blocks, centered with 15px side margins) -->
              <g id="hero-tetris-board" data-hero-tetris transform="translate(15, 14)">
                <!-- Clean Formed Tetromino Fallback (8 full columns 0..7) -->
                <g data-tetris-fallback>
                  <!-- Bottom Row (Row 4, y=64, cols 0..7) -->
                  <rect x="0" y="64" width="14" height="14" fill="currentColor" fill-opacity="0.85" stroke="currentColor" stroke-width="1.1" />
                  <rect x="16" y="64" width="14" height="14" fill="currentColor" fill-opacity="0.85" stroke="currentColor" stroke-width="1.1" />
                  <rect x="32" y="64" width="14" height="14" fill="currentColor" fill-opacity="0.55" stroke="currentColor" stroke-width="1.1" />
                  <rect x="48" y="64" width="14" height="14" fill="currentColor" fill-opacity="0.55" stroke="currentColor" stroke-width="1.1" />
                  <rect x="80" y="64" width="14" height="14" fill="currentColor" fill-opacity="0.85" stroke="currentColor" stroke-width="1.1" />
                  <rect x="96" y="64" width="14" height="14" fill="currentColor" fill-opacity="0.85" stroke="currentColor" stroke-width="1.1" />
                  <rect x="112" y="64" width="14" height="14" fill="currentColor" fill-opacity="0.85" stroke="currentColor" stroke-width="1.1" />

                  <!-- Row 3 (y=48, cols 0..7) -->
                  <rect x="0" y="48" width="14" height="14" fill="currentColor" fill-opacity="0.85" stroke="currentColor" stroke-width="1.1" />
                  <rect x="16" y="48" width="14" height="14" fill="currentColor" fill-opacity="0.85" stroke="currentColor" stroke-width="1.1" />
                  <rect x="32" y="48" width="14" height="14" fill="currentColor" fill-opacity="0.42" stroke="currentColor" stroke-width="1.1" />
                  <rect x="80" y="48" width="14" height="14" fill="currentColor" fill-opacity="0.65" stroke="currentColor" stroke-width="1.1" />
                  <rect x="96" y="48" width="14" height="14" fill="currentColor" fill-opacity="0.85" stroke="currentColor" stroke-width="1.1" />
                  <rect x="112" y="48" width="14" height="14" fill="currentColor" fill-opacity="0.85" stroke="currentColor" stroke-width="1.1" />

                  <!-- Row 2 (y=32) -->
                  <rect x="16" y="32" width="14" height="14" fill="currentColor" fill-opacity="0.65" stroke="currentColor" stroke-width="1.1" />
                  <rect x="32" y="32" width="14" height="14" fill="currentColor" fill-opacity="0.65" stroke="currentColor" stroke-width="1.1" />
                  <rect x="96" y="32" width="14" height="14" fill="currentColor" fill-opacity="0.55" stroke="currentColor" stroke-width="1.1" />
                  <rect x="112" y="32" width="14" height="14" fill="currentColor" fill-opacity="0.55" stroke="currentColor" stroke-width="1.1" />
                </g>
              </g>

              <text
                x="14"
                y="114"
                fill="currentColor"
                font-family="var(--font-mono)"
                font-size="10"
                letter-spacing="0.08em"
                opacity="0.75">INGESTION STREAM</text
              >
              <text
                x="14"
                y="134"
                fill="currentColor"
                font-family="var(--font-sans)"
                font-weight="600"
                font-size="12">84 Manuals &amp; xAPI</text
              >
              <text
                x="14"
                y="150"
                fill="currentColor"
                font-family="var(--font-mono)"
                font-size="10"
                opacity="0.75">RapidOCR + Async I/O</text
              >
            </g>

            <!-- Flow Vector 1 -> 2 -->
            <g stroke="currentColor" stroke-width="1.4">
              <line x1="180" y1="115" x2="246" y2="115" stroke-dasharray="4 4" />
              <polygon points="246,111 254,115 246,119" fill="currentColor" />
            </g>

            <!-- Stage 2: Isometric 2.5D Engine Cube (Hybrid BM25 + Vector + RRF) -->
            <g transform="translate(258, 22)" data-iso-assembly data-stage-node="core">
              <!-- Base Shadow Plinth (Layer 0) -->
              <g data-iso-layer="0">
                <polygon
                  points="82,102 154,140 82,178 10,140"
                  fill="currentColor"
                  fill-opacity="0.06"
                  stroke="currentColor"
                  stroke-opacity="0.4"
                  stroke-width="1"
                  stroke-dasharray="3 3"
                />
              </g>
              <!-- Cube Body (Layer 1) -->
              <g data-iso-layer="1">
                <!-- Left face -->
                <polygon
                  points="10,54 82,92 82,166 10,128"
                  fill="currentColor"
                  fill-opacity="0.08"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <!-- Right face -->
                <polygon
                  points="82,92 154,54 154,128 82,166"
                  fill="currentColor"
                  fill-opacity="0.24"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <line x1="82" y1="92" x2="82" y2="166" stroke="currentColor" stroke-width="1.5" />
              </g>
              <!-- Cube Top Lid & Inner Core (Layer 2) -->
              <g data-iso-layer="2">
                <!-- Top face -->
                <polygon
                  points="82,16 154,54 82,92 10,54"
                  fill="currentColor"
                  fill-opacity="0.18"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <!-- Inner wireframe core -->
                <polygon
                  points="82,36 126,60 82,84 38,60"
                  stroke="currentColor"
                  stroke-width="1"
                  stroke-dasharray="3 3"
                />
                <text
                  x="82"
                  y="60"
                  text-anchor="middle"
                  fill="currentColor"
                  font-family="var(--font-mono)"
                  font-weight="700"
                  font-size="10">RRF + R-OCR</text
                >
              </g>
              <text
                x="82"
                y="192"
                text-anchor="middle"
                fill="currentColor"
                font-family="var(--font-mono)"
                font-size="10"
                letter-spacing="0.08em">BM25 · CHROMADB · MILVUS</text
              >
            </g>

            <!-- Flow Vector 2 -> 3 -->
            <g stroke="currentColor" stroke-width="1.4">
              <line x1="424" y1="115" x2="490" y2="115" stroke-dasharray="4 4" />
              <polygon points="490,111 498,115 490,119" fill="currentColor" />
            </g>

            <!-- Stage 3: Verified Structured Output Matrix -->
            <g transform="translate(500, 34)" data-stage-node="output">
              <rect
                x="0"
                y="0"
                width="166"
                height="162"
                stroke="currentColor"
                stroke-width="1.5"
                fill="currentColor"
                fill-opacity="0.08"
              />
              <!-- Aligned 3x3 precision pixel block -->
              <rect data-output-cell="0" x="16" y="20" width="18" height="18" fill="currentColor" />
              <rect data-output-cell="1" x="40" y="20" width="18" height="18" fill="currentColor" />
              <rect data-output-cell="2" x="64" y="20" width="18" height="18" fill="currentColor" />
              <rect data-output-cell="3" x="16" y="44" width="18" height="18" fill="currentColor" />
              <rect
                data-output-cell="4"
                x="40"
                y="44"
                width="18"
                height="18"
                fill="currentColor"
                fill-opacity="0.35"
                stroke="currentColor"
                stroke-width="1.2"
              />
              <rect data-output-cell="5" x="64" y="44" width="18" height="18" fill="currentColor" />
              <rect data-output-cell="6" x="16" y="68" width="18" height="18" fill="currentColor" />
              <rect data-output-cell="7" x="40" y="68" width="18" height="18" fill="currentColor" />
              <rect data-output-cell="8" x="64" y="68" width="18" height="18" fill="currentColor" />

              <text
                x="96"
                y="46"
                fill="currentColor"
                font-family="var(--font-pixel)"
                font-size="14">TOP-K</text
              >
              <text
                x="96"
                y="64"
                fill="currentColor"
                font-family="var(--font-mono)"
                font-size="9"
                opacity="0.8">RERANKED</text
              >

              <text
                x="16"
                y="116"
                fill="currentColor"
                font-family="var(--font-mono)"
                font-size="10"
                letter-spacing="0.08em"
                opacity="0.8">GROUNDED OUTPUT</text
              >
              <text
                x="16"
                y="136"
                fill="currentColor"
                font-family="var(--font-sans)"
                font-weight="600"
                font-size="12">Cited Page &amp; Part IDs</text
              >
              <text
                x="16"
                y="151"
                fill="currentColor"
                font-family="var(--font-mono)"
                font-size="10"
                opacity="0.8">Async FastAPI Router</text
              >
            </g>
          </svg>
        </div>

        <div class="matrix-stack-strip mono" aria-label="Core production technologies">
          <span>RETRIEVAL: HYBRID BM25 + CHROMADB</span>
          <span class="strip-sep">·</span>
          <span>BACKEND: FASTAPI (UVLOOP) &amp; SPRING BOOT</span>
          <span class="strip-sep">·</span>
          <span>BENCHMARKING: APACHE JMETER &amp; DOCKER</span>
        </div>
      </div>

      <!-- Right: 4-Cell Exposed Blueprint Credential Ledger -->
      <aside class="hero-ledger-col" aria-label="Core engineering foundation and benchmarks">
        <div class="ledger-cell" data-ledger-cell>
          <span class="ledger-label mono">01 // ACADEMIC FOUNDATION</span>
          <strong class="ledger-value">International University (VNU-HCM)</strong>
          <span class="ledger-sub mono">B.S. in Computer Science &amp; Engineering · Expected Late 2026 · GPA 3.0 / 4.0</span>
        </div>

        <div class="ledger-cell" data-ledger-cell>
          <span class="ledger-label mono">02 // COMPETITIVE RECOGNITION</span>
          <div class="ledger-stat-row">
            <span class="pixel-stat" data-count-target="13" data-count-prefix="TOP ">TOP 13</span>
            <span class="ledger-stat-note mono">OF 300+ TEAMS</span>
          </div>
          <span class="ledger-sub mono">FPT Automotive Hackathon 2026 · Team Lead (Android Automotive OS Track)</span>
        </div>

        <div class="ledger-cell" data-ledger-cell>
          <span class="ledger-label mono">03 // PROVEN WORKLOAD</span>
          <div class="ledger-stat-row">
            <span class="pixel-stat" data-count-target="152714" data-count-suffix="+">152,000+</span>
            <span class="ledger-stat-note mono">&lt;120MS P95 WRITE</span>
          </div>
          <span class="ledger-sub mono">Handled student interaction traffic with &lt;120ms p95 MySQL write latency under 500 concurrent users.</span>
        </div>

        <div class="ledger-cell ledger-cell-cta" data-ledger-cell data-hero-cta-content>
          <div class="ledger-cta-row">
            <a class="hero-pixel-arrow-btn" href="#work" aria-label="Scroll to featured work" data-hero-arrow>
              <svg viewBox="0 0 12 12" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true" class="nualt-pixel-arrow">
                <path d="M0 0H8V2H4V3H5V4H6V5H7V6H8V7H9V8H10V9H11V10H12V12H10V11H9V10H8V9H7V8H6V7H5V6H4V5H3V4H2V8H0Z"></path>
              </svg>
            </a>
            <div class="ledger-cta-body">
              <div class="ledger-availability mono">
                <span class="status-beacon" aria-hidden="true"></span>
                <span>OPEN TO ON-SITE &amp; REMOTE ROLES (LATE 2026)</span>
              </div>
              <a class="ledger-action-link mono drawn-link" href="#contact">
                <span>GET IN TOUCH</span>
                <span class="btn-arrow-wrap" aria-hidden="true">
                  <IconArrow width={12} height={12} />
                </span>
              </a>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>
