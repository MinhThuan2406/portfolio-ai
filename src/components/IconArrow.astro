---
interface Props {
  width?: number | string;
  height?: number | string;
  class?: string;
}

const { width = 11, height = 11, class: className = "icon-inline" } = Astro.props;
---

<svg
  class={className}
  width={width}
  height={height}
  viewBox="0 0 12 12"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d="M3.5 8.5L8.5 3.5M4 3.5H8.5V8"></path>
</svg>
