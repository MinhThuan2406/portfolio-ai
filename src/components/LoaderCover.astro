---
// Nualt Exact 100% HomeLoaderCover (3 Centered Tetris Slots + Bottom-Right Rising Logo)
---

<div id="home-loader-cover" class="loader-cover" aria-hidden="true">
  <!-- Dead Center: 3 Tetris Piece Slots ONLY -->
  <div class="loader-slots" id="loader-slots">
    <!-- Slot 0: T piece (cells: [[0,0],[1,0],[2,0],[1,1]], starts at 180deg) -->
    <div class="loader-slot" style="--cells: 3;" data-slot="0">
      <div class="slot-outline">
        <svg viewBox="0 0 3 2" shape-rendering="crispEdges">
          <rect x="0.06" y="0.06" width="0.88" height="0.88" fill="none" stroke="currentColor" stroke-width="0.045"></rect>
          <rect x="1.06" y="0.06" width="0.88" height="0.88" fill="none" stroke="currentColor" stroke-width="0.045"></rect>
          <rect x="2.06" y="0.06" width="0.88" height="0.88" fill="none" stroke="currentColor" stroke-width="0.045"></rect>
          <rect x="1.06" y="1.06" width="0.88" height="0.88" fill="none" stroke="currentColor" stroke-width="0.045"></rect>
        </svg>
      </div>
      <div class="slot-piece" data-piece="0">
        <svg viewBox="0 0 3 2" shape-rendering="crispEdges">
          <rect x="0.06" y="0.06" width="0.88" height="0.88" fill="currentColor"></rect>
          <rect x="1.06" y="0.06" width="0.88" height="0.88" fill="currentColor"></rect>
          <rect x="2.06" y="0.06" width="0.88" height="0.88" fill="currentColor"></rect>
          <rect x="1.06" y="1.06" width="0.88" height="0.88" fill="currentColor"></rect>
        </svg>
      </div>
    </div>

    <!-- Slot 1: S piece (cells: [[1,0],[2,0],[0,1],[1,1]], starts at 90deg) -->
    <div class="loader-slot" style="--cells: 3;" data-slot="1">
      <div class="slot-outline">
        <svg viewBox="0 0 3 2" shape-rendering="crispEdges">
          <rect x="1.06" y="0.06" width="0.88" height="0.88" fill="none" stroke="currentColor" stroke-width="0.045"></rect>
          <rect x="2.06" y="0.06" width="0.88" height="0.88" fill="none" stroke="currentColor" stroke-width="0.045"></rect>
          <rect x="0.06" y="1.06" width="0.88" height="0.88" fill="none" stroke="currentColor" stroke-width="0.045"></rect>
          <rect x="1.06" y="1.06" width="0.88" height="0.88" fill="none" stroke="currentColor" stroke-width="0.045"></rect>
        </svg>
      </div>
      <div class="slot-piece" data-piece="1">
        <svg viewBox="0 0 3 2" shape-rendering="crispEdges">
          <rect x="1.06" y="0.06" width="0.88" height="0.88" fill="currentColor"></rect>
          <rect x="2.06" y="0.06" width="0.88" height="0.88" fill="currentColor"></rect>
          <rect x="0.06" y="1.06" width="0.88" height="0.88" fill="currentColor"></rect>
          <rect x="1.06" y="1.06" width="0.88" height="0.88" fill="currentColor"></rect>
        </svg>
      </div>
    </div>

    <!-- Slot 2: L piece (cells: [[0,0],[0,1],[1,1],[2,1]], starts at 270deg) -->
    <div class="loader-slot" style="--cells: 3;" data-slot="2">
      <div class="slot-outline">
        <svg viewBox="0 0 3 2" shape-rendering="crispEdges">
          <rect x="0.06" y="0.06" width="0.88" height="0.88" fill="none" stroke="currentColor" stroke-width="0.045"></rect>
          <rect x="0.06" y="1.06" width="0.88" height="0.88" fill="none" stroke="currentColor" stroke-width="0.045"></rect>
          <rect x="1.06" y="1.06" width="0.88" height="0.88" fill="none" stroke="currentColor" stroke-width="0.045"></rect>
          <rect x="2.06" y="1.06" width="0.88" height="0.88" fill="none" stroke="currentColor" stroke-width="0.045"></rect>
        </svg>
      </div>
      <div class="slot-piece" data-piece="2">
        <svg viewBox="0 0 3 2" shape-rendering="crispEdges">
          <rect x="0.06" y="0.06" width="0.88" height="0.88" fill="currentColor"></rect>
          <rect x="0.06" y="1.06" width="0.88" height="0.88" fill="currentColor"></rect>
          <rect x="1.06" y="1.06" width="0.88" height="0.88" fill="currentColor"></rect>
          <rect x="2.06" y="1.06" width="0.88" height="0.88" fill="currentColor"></rect>
        </svg>
      </div>
    </div>
  </div>

  <!-- Bottom-Right Architectural Wordmark (Exact Nualt Placement & Rise Keyframe) -->
  <div class="loader-logo-window">
    <div class="loader-logo mono" id="loader-logo">
      <span class="logo-name">THUAN</span><span class="logo-sub">.DEV</span>
    </div>
  </div>
</div>

<style>
  .loader-cover {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background-color: var(--cobalt, #0755b5);
    color: var(--ivory, #f4f2e8);
    display: grid;
    place-content: center;
    user-select: none;
    pointer-events: all;
    will-change: transform;
  }

  html[data-theme="dark"] .loader-cover {
    background-color: #0b3c7c;
    color: #f4f2e8;
  }

  /* Once dismissed, hide entirely */
  .loader-cover.is-dismissed {
    display: none !important;
    pointer-events: none !important;
  }

  /* Exact Nualt Loader Slots CSS */
  .loader-slots {
    align-items: flex-end;
    gap: 24px;
    display: flex;
    will-change: transform;
  }

  .loader-slot {
    width: calc(var(--cells, 3) * 16px);
    height: 32px;
    display: block;
    position: relative;
  }

  .loader-slot svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .slot-outline {
    position: absolute;
    inset: 0;
    opacity: 1;
  }

  .slot-piece {
    position: absolute;
    inset: 0;
    translate: 0 -64px;
    opacity: 1;
    will-change: rotate, translate;
  }

  /* Initial rotations in Nualt */
  .slot-piece[data-piece="0"] {
    rotate: 180deg;
  }
  .slot-piece[data-piece="1"] {
    rotate: 90deg;
  }
  .slot-piece[data-piece="2"] {
    rotate: 270deg;
  }

  /* Exact Nualt Logo Window in bottom-right corner */
  .loader-logo-window {
    position: absolute;
    bottom: 2rem;
    right: 4rem;
    overflow: hidden;
  }

  .loader-logo {
    display: flex;
    align-items: baseline;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    will-change: transform;
    animation: loaderLogoRise 0.7s cubic-bezier(0.32, 0, 0.12, 1) 0.15s both;
  }

  @keyframes loaderLogoRise {
    0% {
      transform: translateY(100%);
    }
  }

  .logo-name {
    font-family: var(--font-display, 'yellix', sans-serif);
    font-size: 1.5rem;
  }

  .logo-sub {
    font-family: var(--font-pixel);
    font-size: 0.9rem;
    opacity: 0.85;
    margin-left: 0.2rem;
  }

  @media (max-width: 768px) {
    .loader-logo-window {
      bottom: 1.5rem;
      right: 1.5rem;
    }
  }
</style>
