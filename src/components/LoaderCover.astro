---

<div id="home-loader-cover" class="loader-cover" aria-hidden="true">
  <span class="loader-crosshair cross-tl mono" aria-hidden="true">+</span>
  <span class="loader-crosshair cross-tr mono" aria-hidden="true">+</span>
  <span class="loader-crosshair cross-bl mono" aria-hidden="true">+</span>
  <span class="loader-crosshair cross-br mono" aria-hidden="true">+</span>

  <div class="loader-stage" id="loader-stage">
    <div class="loader-typography-wrap">
      <svg
        id="loader-name-svg"
        class="loader-name-svg"
        viewBox="0 0 7699 780"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-label="NGUYEN THUAN"
      >
        {
          letters.map((l, i) => (
            <g class="loader-glyph" data-letter-index={i} data-char={l.char}>
              <path
                class="glyph-fill"
                d={l.d}
                fill="#0755b5"
                opacity="0"
              />
              <path
                class="glyph-stroke"
                d={l.d}
                fill="none"
                stroke="#0755b5"
                stroke-width="14"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </g>
          ))
        }
      </svg>
    </div>

    <div class="loader-telemetry">
      <div class="loader-telemetry-meta mono">
        <span class="telemetry-label">SYS_INIT // NGUYEN THUAN</span>
        <span id="loader-counter" class="telemetry-counter">000%</span>
      </div>
      <div class="loader-progress-track">
        <div id="loader-progress-bar" class="loader-progress-bar"></div>
      </div>
    </div>
  </div>
</div>

<style>
  :global(html[data-loader]),
  :global(html[data-loader] body) {
    overflow: hidden !important;
  }

  .loader-cover {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--bg, #f4f2e8);
    background-image: radial-gradient(
      rgba(7, 85, 181, 0.08) 1px,
      transparent 1px
    );
    background-size: 32px 32px;
    user-select: none;
    pointer-events: all;
    overflow: hidden;
    will-change: clip-path, opacity;
  }

  .loader-cover.is-dismissed {
    display: none !important;
    pointer-events: none !important;
  }

  .loader-crosshair {
    position: absolute;
    font-size: 15px;
    font-weight: 500;
    color: #0755b5;
    opacity: 0.38;
    pointer-events: none;
    line-height: 1;
  }

  .cross-tl {
    top: 28px;
    left: 28px;
  }

  .cross-tr {
    top: 28px;
    right: 28px;
  }

  .cross-bl {
    bottom: 28px;
    left: 28px;
  }

  .cross-br {
    bottom: 28px;
    right: 28px;
  }

  .loader-stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 92vw;
    max-width: 960px;
    padding: 24px;
    box-sizing: border-box;
    will-change: transform, opacity;
  }

  .loader-typography-wrap {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .loader-name-svg {
    width: 100%;
    height: auto;
    max-height: 150px;
    display: block;
    overflow: visible;
  }

  .loader-glyph {
    transform-origin: center center;
  }

  .glyph-stroke {
    opacity: 0.95;
    will-change: stroke-dashoffset;
  }

  .glyph-fill {
    will-change: opacity;
  }

  .loader-telemetry {
    width: 100%;
    max-width: 320px;
    margin-top: 40px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .loader-telemetry-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 11px;
    letter-spacing: 0.12em;
    color: #0755b5;
  }

  .telemetry-label {
    opacity: 0.72;
  }

  .telemetry-counter {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    opacity: 0.95;
  }

  .loader-progress-track {
    width: 100%;
    height: 2px;
    background: rgba(7, 85, 181, 0.14);
    position: relative;
    overflow: hidden;
  }

  .loader-progress-bar {
    width: 100%;
    height: 100%;
    background: #0755b5;
    transform-origin: left center;
    transform: scaleX(0);
    will-change: transform;
  }

  @media (max-width: 767px) {
    .cross-tl {
      top: 16px;
      left: 16px;
    }
    .cross-tr {
      top: 16px;
      right: 16px;
    }
    .cross-bl {
      bottom: 16px;
      left: 16px;
    }
    .cross-br {
      bottom: 16px;
      right: 16px;
    }

    .loader-stage {
      width: 96vw;
      padding: 16px;
    }

    .loader-telemetry {
      max-width: 240px;
      margin-top: 28px;
    }

    .loader-telemetry-meta {
      font-size: 10px;
    }
  }
</style>
