---
import "../styles/global.css";
import Header from "../components/Header.astro";
import LoaderCover from "../components/LoaderCover.astro";
import Hero from "../components/Hero.astro";
import FeaturedDossier from "../components/FeaturedDossier.astro";
import ProductionPipelines from "../components/ProductionPipelines.astro";
import StackArchitecture from "../components/StackArchitecture.astro";
import TrajectoryLedger from "../components/TrajectoryLedger.astro";
import ContactHandshake from "../components/ContactHandshake.astro";
import CvModal from "../components/CvModal.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f2e8" id="meta-theme-color" />
    <script is:inline>
      (function () {
        if ('scrollRestoration' in history) {
          history.scrollRestoration = 'manual';
        }
        window.scrollTo(0, 0);
        document.documentElement.setAttribute("data-motion", "full");
        document.documentElement.setAttribute("data-loader", "");
      })();
    </script>
    <title>Nguyen Thuan · Portfolio</title>
    <meta
      name="description"
      content="Engineering portfolio of Nguyen Minh Thuan. Building reliable RAG pipelines over unstructured technical documents, low-latency event telemetry, and resilient backend services."
    />
    <meta name="author" content="Nguyen Minh Thuan" />
    <link rel="canonical" href="https://thuannm04.vercel.app/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link
      rel="preload"
      href="/fonts/yellix.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/geist-pixel.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://thuannm04.vercel.app/" />
    <meta
      property="og:title"
      content="Nguyen Minh Thuan · High-Throughput Backends & Search Systems"
    />
    <meta
      property="og:description"
      content="Engineering portfolio of Nguyen Minh Thuan. Building reliable RAG pipelines over unstructured technical documents, low-latency event telemetry, and resilient backend services."
    />
    <meta property="og:image" content="/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Nguyen Minh Thuan · AI Systems & Backend Engineering Portfolio"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Nguyen Minh Thuan · High-Throughput Backends & Search Systems"
    />
    <meta
      name="twitter:description"
      content="Engineering portfolio of Nguyen Minh Thuan. Building reliable RAG pipelines over unstructured technical documents, low-latency event telemetry, and resilient backend services."
    />
    <meta name="twitter:image" content="/og-image.png" />

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "ProfilePage",
        "url": "https://thuannm04.vercel.app",
        "mainEntity": {
          "@type": "Person",
          "name": "Nguyen Minh Thuan",
          "jobTitle": "AI Engineer & Backend Engineer",
          "email": "thuannm0426@gmail.com",
          "telephone": "+84819786704",
          "alumniOf": {
            "@type": "CollegeOrUniversity",
            "name": "International University - VNU-HCM"
          },
          "knowsAbout": [
            "AI Systems",
            "Backend Engineering",
            "Data Pipelines",
            "Hybrid RAG Search",
            "FastAPI",
            "PyTorch",
            "PostgreSQL",
            "Docker"
          ],
          "sameAs": [
            "https://github.com/MinhThuan2406",
            "https://linkedin.com/in/nguyenthuan2406"
          ]
        }
      }
    </script>
  </head>
  <body>
    <LoaderCover />
    <a class="skip-link mono" href="#work">SKIP TO CONTENT [ENTER]</a>

    <Header />

    <main id="top">
      <Hero />
      <FeaturedDossier />
      <ProductionPipelines />
      <StackArchitecture />
      <TrajectoryLedger />
    </main>

    <ContactHandshake />
    <CvModal />

    <a
      id="floating-back-to-top"
      class="floating-back-to-top mono"
      href="#top"
      aria-label="Back to top"
    >
      <span class="btn-text">TOP ↑</span>
    </a>

    <script src="../scripts/navigation.ts"></script>
    <script src="../scripts/interactive.ts"></script>
    <script src="../scripts/animations.ts"></script>
  </body>
</html>
